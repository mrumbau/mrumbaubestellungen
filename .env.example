# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI
OPENAI_API_KEY=sk-...

# Make.com Webhook Sicherheit
MAKE_WEBHOOK_SECRET=geheimer-key-hier

# Google Cloud Vision – OCR-Fallback der E-Mail-Pipeline
GOOGLE_CLOUD_VISION_API_KEY=AIza...

# Microsoft Graph (E-Mail-Sync, ersetzt Make.com)
MS_TENANT_ID=tenant-uuid-hier
MS_CLIENT_ID=client-uuid-hier
MS_CLIENT_SECRET=secret-hier
MS_MAILBOX=info@deine-domain.de

# Vercel Cron Authentication (openssl rand -hex 32)
CRON_SECRET=zufalls-hex-string-hier

# ── SMTP für Erinnerungs-/DATEV-Mails (optional) ────────────────────────
SMTP_USER=info@deine-domain.de
SMTP_PASSWORD=app-passwort-hier

# ── Internal Loopback / Dev-Helpers (optional) ──────────────────────────
# Wird von src/lib/email-pipeline/{classify,ingest}.ts für HTTP-Loopback
# zum eigenen webhook/email + webhook/email-check verwendet.
# In Vercel-Production wird VERCEL_URL auto-injected; lokal NEXT_PUBLIC_APP_URL.
# INTERNAL_APP_URL überschreibt beides falls gesetzt.
# INTERNAL_APP_URL=https://cloud.mrumbau.de
# NEXT_PUBLIC_APP_URL=http://localhost:3000
